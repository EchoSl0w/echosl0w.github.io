---
layout: compress
permalink: /feed.xml
# Atom Feed, reference: https://validator.w3.org/feed/docs/atom.html
---

{% capture source %}
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <id>{{ "/" | absolute_url }}</id>
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang }}"
    href="{{ '/' | absolute_url }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights> © {{ 'now' | date: '%Y' }} {{ site.social.name }} </rights>
  <icon>{{ site.baseurl }}/assets/img/favicons/favicon.ico</icon>
  <logo>{{ site.baseurl }}/assets/img/favicons/favicon-96x96.png</logo>

{% for post in site.posts %}
  {% unless post.tags contains "CTF" %}
    {% assign post_absolute_url = post.url | absolute_url %}
    <entry>
      <title>{{ post.title }}</title>
      <link href="{{ post_absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
      <published>{{ post.date | date_to_xmlschema }}</published>
    {% if post.last_modified_at %}
      <updated>{{ post.last_modified_at | date_to_xmlschema }}</updated>
    {% else %}
      <updated>{{ post.date | date_to_xmlschema }}</updated>
    {% endif %}
      <id>{{ post_absolute_url }}</id>
      <content type="text/html" src="{{ post_absolute_url }}" />
      <author>
        <name>{{ post.author | default: site.social.name }}</name>
      </author>

    {% if post.categories %}
      {% for category in post.categories %}
      <category term="{{ category }}" />
      {% endfor %}
    {% endif %}

    {% assign post_image = nil %}
    {% if post.image %}
      {% assign post_image = post.image.path | default: post.image %}
    {% endif %}

    {% if post_image %}
      {% assign post_image_url = post_image %}
      {% if post_image_url contains '://' %}
        {% assign post_image_url = post_image_url %}
      {% else %}
        {% assign post_image_url = post_image_url | absolute_url %}
      {% endif %}

      {% assign post_image_type = 'image/jpeg' %}
      {% if post_image_url contains '.png' %}
        {% assign post_image_type = 'image/png' %}
      {% elsif post_image_url contains '.gif' %}
        {% assign post_image_type = 'image/gif' %}
      {% elsif post_image_url contains '.webp' %}
        {% assign post_image_type = 'image/webp' %}
      {% endif %}

      <link rel="enclosure" type="{{ post_image_type }}" href="{{ post_image_url | xml_escape }}" />
      <media:content url="{{ post_image_url | xml_escape }}" medium="image" type="{{ post_image_type }}" />
      <summary type="html"><![CDATA[<img src="{{ post_image_url | xml_escape }}" alt="{{ post.title | xml_escape }}" style="max-width:100%;height:auto;" /><br />{% include post-summary.html max_length=400 %}]]></summary>
    {% else %}
      <summary>{% include post-summary.html max_length=400 %}</summary>
    {% endif %}

    </entry>
  {% endunless %}
{% endfor %}
</feed>
{% endcapture %}
{{ source | replace: '&', '&amp;' }}
